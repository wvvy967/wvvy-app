{
  "name": "wvvy-app",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "#Core": "Web development and build",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "#Device dev": "Serve the bundle to a real device for HMR — see capacitor.config.ts",
    "dev:host": "vite dev --host --port 5001",
    "#Native sync": "Copy the built web bundle into the native projects",
    "sync": "cap sync",
    "sync:ios": "cap sync ios",
    "sync:android": "cap sync android",
    "#Icons": "Regenerate every launcher icon and splash from assets/ — see assets/README.md",
    "assets": "capacitor-assets generate --ios --android",
    "#Screenshots": "Regenerate the App Store + Play screenshot sets from the iOS Simulator and Android emulator — see tools/screenshots/README.md",
    "screenshots": "node tools/screenshots/capture.mjs",
    "screenshots:ios": "node tools/screenshots/capture.mjs ios",
    "screenshots:android": "node tools/screenshots/capture.mjs android",
    "#Native open": "Build, sync, then open the platform IDE",
    "ios": "run-s build sync:ios open:ios",
    "android": "run-s build sync:android open:android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "#Release": "Build, sign and upload (TestFlight / Play internal) exactly as CI does — see .env.release.example and docs/releasing.md",
    "release:ios": "bash scripts/release-ios.sh",
    "release:android": "bash scripts/release-android.sh",
    "#Native run": "Build, then compile and boot the app onto a simulator or device. `&&` (not run-s) so `npm run sim:ios -- --target <id>` passes the flag through: npm appends args to the script string, and only a chain ending in `cap` hands them over intact. targets:* lists device/simulator ids to pin.",
    "sim:ios": "npm run build && cap run ios",
    "sim:android": "npm run build && cap run android",
    "run:ios": "cap run ios",
    "run:android": "cap run android",
    "targets:ios": "cap run ios --list",
    "targets:android": "cap run android --list",
    "#Quality": "Checks",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "all": "npm run format && npm run lint && npm run check && npm run test && npm run build"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "@katama-labs/vite-pwa-sveltekit": "^2.0.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "jsdom": "^30.1.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@lucide/svelte": "^1.25.0",
    "capacitor-plugin-system-volume": "^0.4.1"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
