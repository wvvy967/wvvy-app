<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme.
         Dark, not the stock Theme.AppCompat.Light: a Light parent gives a white
         windowBackground, and from Android 15 the system bars are transparent
         and edge-to-edge is enforced — so that white paints straight through
         behind the status bar and gesture nav, framing the app in white and
         leaving the white status-bar icons nearly invisible. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/ink</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/ink</item>
        <!-- Transparent bars so the webview's ink background runs edge to edge.
             Ignored on API 35+ where the platform enforces this anyway, but it
             keeps older devices consistent. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- false = light (white) icons, which is what reads on our dark bars.
             The naming is inverted: the flag asks "is the bar background light?" -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/ink</item>
        <!-- Where the app lands once the splash clears; without this it falls
             back to AppTheme and loses the bar styling above. -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
